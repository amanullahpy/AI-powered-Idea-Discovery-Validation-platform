# -----------------------------------------------------------------------------
# Deployment & Environment Configuration
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# Site & Public App URLs (Used for SEO, canonical tags, and safe redirects)
# -----------------------------------------------------------------------------
# In production, set to your production domain (e.g. https://ideaforge.ai)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional Vercel deployment URL (auto-populated on Vercel)
# NEXT_PUBLIC_VERCEL_URL=

# -----------------------------------------------------------------------------
# Supabase Backend Configuration
# -----------------------------------------------------------------------------
SUPABASE_PROJECT_REF=ref
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321/
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=publishable_key

# -----------------------------------------------------------------------------
# AI Provider API Keys (Server-side optional or configured per user in UI)
# -----------------------------------------------------------------------------
# Groq Cloud (Fastest ~300 tokens/sec): https://console.groq.com/keys
GROQ_API_KEY=
# Custom Groq endpoint override (optional, defaults to official endpoint)
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# OpenRouter Free Models Hub: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Custom OpenRouter endpoint override (optional, defaults to official endpoint)
# OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# Google AI Studio (Gemini 2.0 / 1.5 Flash): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Custom Gemini endpoint override (optional, defaults to official endpoint)
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
